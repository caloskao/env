alias ls="LC_COLLATE=C ls --color --group-directories-first"
alias ll="LC_COLLATE=C ls -alhF --time-style=+%Y-%m-%d\ %H:%M:%S"
alias la="LC_COLLATE=C ls -ahF"

alias history="history -i 0"

alias py="python3"

alias bat="batcat --color=always --theme=Monokai\ Extended"
alias batn="batcat --style=changes,header"

alias pwgen="pwgen -r Oo01l"
