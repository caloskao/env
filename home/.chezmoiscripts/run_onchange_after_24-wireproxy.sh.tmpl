{{ if .modules.network -}}
#!/bin/bash
# wireproxy 執行檔 + systemd template；設定檔用 `sudo ~/.local/bin/manage-wireproxy` 產生
set -euo pipefail

arch=$(dpkg --print-architecture)
asset="wireproxy_linux_${arch}.tar.gz"
base=https://github.com/pufferffish/wireproxy/releases/latest/download

if [ ! -x /usr/local/bin/wireproxy ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL "$base/$asset" -o "$tmp/$asset"
    curl -fsSL "$base/checksums.txt" -o "$tmp/checksums.txt"
    (cd "$tmp" && grep " $asset\$" checksums.txt | sha256sum -c -)
    tar -xzf "$tmp/$asset" -C "$tmp" wireproxy
    sudo install -m 0755 "$tmp/wireproxy" /usr/local/bin/wireproxy
fi

sudo mkdir -p /etc/wireproxy/wg-conf
sudo tee /etc/systemd/system/wireproxy@.service >/dev/null <<'UNIT'
[Unit]
Description=Wireproxy Service - %I
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wireproxy -c /etc/wireproxy/%i.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
if [ -d /run/systemd/system ]; then
    sudo systemctl daemon-reload
fi
{{ end -}}
