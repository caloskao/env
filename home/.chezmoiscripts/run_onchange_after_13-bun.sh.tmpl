{{ if .modules.bun -}}
#!/bin/bash
# bun；SHELL=/bin/sh 讓 installer 走「只印提示、不改 rc 檔」的分支，completion 另外產生
set -euo pipefail

export BUN_INSTALL="$HOME/.bun"
if [ ! -x "$BUN_INSTALL/bin/bun" ]; then
    curl -fsSL https://bun.sh/install | SHELL=/bin/sh bash
fi
IS_BUN_AUTO_UPDATE=true SHELL=zsh "$BUN_INSTALL/bin/bun" completions >/dev/null || :
{{ end -}}
