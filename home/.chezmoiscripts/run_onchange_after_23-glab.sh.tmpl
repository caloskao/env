{{ if .modules.devcli -}}
#!/bin/bash
# glab：Ubuntu repo 的版本太舊，改裝 GitLab 官方 release 的 .deb（驗 checksum）
set -euo pipefail

arch=$(dpkg --print-architecture)
release=$(curl -fsSL 'https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases?per_page=1' | jq '.[0]')
version=$(jq -r '.tag_name | ltrimstr("v")' <<<"$release")
deb="glab_${version}_linux_${arch}.deb"

if [ "$(dpkg-query -W -f='${Version}' glab 2>/dev/null || true)" = "$version" ]; then
    echo "glab $version already installed"
    exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
for name in "$deb" checksums.txt; do
    url=$(jq -r --arg n "$name" '.assets.links[] | select(.name == $n) | .url' <<<"$release")
    curl -fsSL "$url" -o "$tmp/$name"
done
(cd "$tmp" && grep " $deb\$" checksums.txt | sha256sum -c -)
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "$tmp/$deb"
{{ end -}}
