{{ if .modules.network -}}
#!/bin/bash
# wireproxyctl（https://github.com/caloskao/wireproxyctl）負責安裝 wireproxy 和管理 profile
set -euo pipefail

if [ ! -x /usr/local/bin/wireproxyctl ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL https://github.com/caloskao/wireproxyctl/releases/latest/download/wireproxyctl -o "$tmp/wireproxyctl"
    sudo install -m 0755 "$tmp/wireproxyctl" /usr/local/bin/wireproxyctl
fi

# wireproxyctl install 需要 systemd（daemon-reload），container 裡沒有，略過
if [ -d /run/systemd/system ]; then
    sudo wireproxyctl install
else
    echo "skip: systemd is not running, run 'sudo wireproxyctl install' later"
fi
{{ end -}}
