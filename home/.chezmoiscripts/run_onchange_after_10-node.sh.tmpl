{{ if .modules.node -}}
#!/bin/bash
# nvm + Node LTS；PROFILE=/dev/null 讓 nvm installer 不改寫 rc 檔（載入段落在 .zshrc）
set -euo pipefail

export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/HEAD/install.sh | PROFILE=/dev/null bash
fi

set +u
source "$NVM_DIR/nvm.sh"
# LTS 換版時把舊 default 的全域套件（例如 codegraph）帶到新版本
prev=$(nvm version default)
lts=$(nvm version-remote --lts)
if [ "$prev" != "N/A" ] && [ "$prev" != "$lts" ]; then
    nvm install "$lts" --reinstall-packages-from="$prev"
else
    nvm install "$lts"
fi
nvm alias default 'lts/*'
{{ end -}}
